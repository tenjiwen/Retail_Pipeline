      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{9897DD5C-C056-4E60-BAB1-52CBC2B6CF96}"
          SQLTask:SqlStatementSource="IF NOT EXISTS (&#xA;    SELECT * FROM sys.databases WHERE name = 'retail_dw')&#xA;    BEGIN&#xA;      CREATE DATABASE retail_dw;&#xA;END;&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
