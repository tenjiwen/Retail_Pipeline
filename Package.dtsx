    <DTS:Executable
      DTS:refId="Package\create db schema"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Create bronze,silver,gold schema"
      DTS:DTSID="{DE52CBA6-46CA-4DAA-BDDE-A13BE0AAA8A7}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="create db schema"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{9897DD5C-C056-4E60-BAB1-52CBC2B6CF96}"
          SQLTask:SqlStatementSource="USE retail_stg;&#xA;&#xA;IF NOT EXISTS (&#xA;    SELECT * FROM sys.schemas WHERE name = 'bronze_rtl')  BEGIN&#xA;    EXEC('CREATE SCHEMA bronze_rtl');&#xA;END;&#xA;&#xA;USE retail_dw;&#xA;&#xA;IF NOT EXISTS (&#xA;    SELECT * FROM sys.schemas WHERE name = 'silver_rtl')  BEGIN&#xA;    EXEC('CREATE SCHEMA silver_rtl');&#xA;END;&#xA;&#xA;IF NOT EXISTS (&#xA;    SELECT * FROM sys.schemas WHERE name = 'gold_rtl')  BEGIN&#xA;    EXEC('CREATE SCHEMA gold_rtl');&#xA;END;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\create retail_dw db"
